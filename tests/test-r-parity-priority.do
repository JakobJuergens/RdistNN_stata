test_section "R parity priorities: [ties] batch target order and determinism"

clear
set obs 10
gen double x1 = _n
gen double x2 = 0
gen double rho_tied = 0.25*_n^2 - _n
matrix X0_tied = (5,0 \ 5,1 \ 5,-1)
matrix X0_tied_perm = (5,-1 \ 5,0 \ 5,1)

quietly cate_dnn rho_tied, xcols(x1 x2) x0matrix(X0_tied) ///
    pseudooutcome k(1) s(4)
matrix B_tied = e(b)
matrix V_tied = e(V)
quietly cate_dnn rho_tied, xcols(x1 x2) x0matrix(X0_tied) ///
    pseudooutcome k(1) s(4)
matrix B_tied_repeat = e(b)
matrix V_tied_repeat = e(V)
quietly cate_dnn rho_tied, xcols(x1 x2) x0matrix(X0_tied_perm) ///
    pseudooutcome k(1) s(4)
matrix B_tied_perm = e(b)
matrix V_tied_perm = e(V)
mata {
    _tie_idx = (3, 1, 2)
    st_numscalar("_tie_repeat_b", max(abs(st_matrix("B_tied") - st_matrix("B_tied_repeat"))))
    st_numscalar("_tie_repeat_v", max(abs(st_matrix("V_tied") - st_matrix("V_tied_repeat"))))
    st_numscalar("_tie_perm_b", max(abs(st_matrix("B_tied_perm") - st_matrix("B_tied")[,_tie_idx])))
    st_numscalar("_tie_perm_v", max(abs(st_matrix("V_tied_perm") - st_matrix("V_tied")[_tie_idx,_tie_idx])))
}
test_assert "[ties] repeated batch estimates are deterministic" scalar(_tie_repeat_b) == 0
test_assert "[ties] repeated batch covariance is deterministic" scalar(_tie_repeat_v) == 0
test_assert "[ties] permuting targets permutes estimates" scalar(_tie_perm_b) < 1e-12
test_assert "[ties] permuting targets permutes joint covariance" scalar(_tie_perm_v) < 1e-12
