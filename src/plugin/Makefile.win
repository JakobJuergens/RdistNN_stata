# Makefile.win - RdistNN Stata plugin (Windows, MSVC)
#
# Usage from a "Developer Command Prompt for VS":
#   nmake /f Makefile.win           - build rdistnn.plugin
#   nmake /f Makefile.win clean     - remove build artifacts
#
# Requires: Visual Studio C++ Build Tools 2019 or later (any edition).
# Keep this file ASCII: NMAKE can reject UTF-8 on non-UTF-8 Windows code pages.
# Open "x64 Native Tools Command Prompt for VS 20xx" before running.
#
# The compiled rdistnn.plugin must be placed on Stata's adopath.

CXX      = cl
CXXFLAGS = /std:c++17 /O2 /W3 /EHsc /nologo /wd4190
LDFLAGS  = /LD /nologo

TARGET   = rdistnn.plugin
CORE_TEST = rdistnn_core_test.exe
DISTANCE_TEST = rdistnn_distance_test.exe
PROTOCOL_TEST = rdistnn_distance_plugin_test.exe
ROUNDING_TEST = rdistnn_distance_rounding_test.exe
BLOCK_TEST = rdistnn_blocks_test.exe
LOO_PROTOCOL_TEST = rdistnn_loo_plugin_test.exe
HEADERS  = rdistnn_core.hpp rdistnn_distance.hpp compensated_arithmetic.hpp distance_arithmetic.hpp
SRCS     = stplugin.c rdistnn_plugin.cpp

$(TARGET): $(SRCS) $(HEADERS) stplugin.h
	$(CXX) $(CXXFLAGS) $(LDFLAGS) /Fe$(TARGET) $(SRCS)
	-del /f rdistnn_plugin.obj stplugin.obj rdistnn.exp rdistnn.lib 2>nul

$(CORE_TEST): test_rdistnn_core.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) /Fe$(CORE_TEST) test_rdistnn_core.cpp
	-del /f test_rdistnn_core.obj 2>nul

$(DISTANCE_TEST): test_rdistnn_distance.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) /Fe$(DISTANCE_TEST) test_rdistnn_distance.cpp
	-del /f test_rdistnn_distance.obj 2>nul

$(PROTOCOL_TEST): test_rdistnn_distance_plugin.cpp rdistnn_plugin.cpp $(HEADERS) stplugin.h
	$(CXX) $(CXXFLAGS) /Fe$(PROTOCOL_TEST) test_rdistnn_distance_plugin.cpp
	-del /f test_rdistnn_distance_plugin.obj 2>nul

$(ROUNDING_TEST): test_rdistnn_distance_rounding.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) /Fe$(ROUNDING_TEST) test_rdistnn_distance_rounding.cpp
	-del /f test_rdistnn_distance_rounding.obj 2>nul

$(BLOCK_TEST): test_rdistnn_blocks.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) /Fe$(BLOCK_TEST) test_rdistnn_blocks.cpp
	-del /f test_rdistnn_blocks.obj 2>nul


$(LOO_PROTOCOL_TEST): test_rdistnn_loo_plugin.cpp rdistnn_plugin.cpp $(HEADERS) stplugin.h
	$(CXX) $(CXXFLAGS) /Fe$(LOO_PROTOCOL_TEST) test_rdistnn_loo_plugin.cpp
	-del /f test_rdistnn_loo_plugin.obj 2>nul

check: $(CORE_TEST) $(DISTANCE_TEST) $(PROTOCOL_TEST) $(ROUNDING_TEST) $(BLOCK_TEST) $(LOO_PROTOCOL_TEST)
	$(CORE_TEST)
	$(DISTANCE_TEST) 2 2 0.5790338377234229 1.4758492921057114
	$(PROTOCOL_TEST)
	$(ROUNDING_TEST) 2 2 0.5790338377234229 1.4758492921057114
	$(BLOCK_TEST)
	$(LOO_PROTOCOL_TEST)

clean:
	-del /f $(TARGET) $(CORE_TEST) $(DISTANCE_TEST) $(PROTOCOL_TEST) $(ROUNDING_TEST) $(BLOCK_TEST) $(LOO_PROTOCOL_TEST) *.obj *.exp *.lib

# Alternative: build with MinGW/GCC (e.g. via Rtools)
#
# From a shell where gcc is on PATH (Rtools MSYS2 terminal):
#
#   g++ -std=c++17 -O3 -shared -o rdistnn.plugin stplugin.c rdistnn_plugin.cpp
#
# Note: On Windows, .plugin files are DLLs regardless of extension.
